# Copy to .env (gitignored) and replace every change-me. Never commit .env.

# --- Hub ---------------------------------------------------------------
# The hub's LAN address: the dashboard, the Frigate UI (and with the profiles
# below, MQTT and Home Assistant) are published on this address only.
HUB_LAN_IP=192.168.1.10
TZ=Africa/Casablanca
# Optional services: comma-separated profiles, e.g. mqtt-lan,ha
COMPOSE_PROFILES=
# Owner of data/homeguard on the host (run `id -u` / `id -g`).
HOMEGUARD_UID=1000
HOMEGUARD_GID=1000

# --- MQTT accounts (scripts/mqtt-passwd.sh turns these into the passwd file)
MQTT_HOMEGUARD_USER=homeguard
MQTT_HOMEGUARD_PASSWORD=change-me
MQTT_FRIGATE_USER=frigate
MQTT_FRIGATE_PASSWORD=change-me
MQTT_Z2M_USER=zigbee2mqtt
MQTT_Z2M_PASSWORD=change-me
# Only with the `ha` profile.
MQTT_HA_USER=
MQTT_HA_PASSWORD=

# --- Cameras (Frigate) -----------------------------------------------------
FRIGATE_RTSP_USER=change-me
FRIGATE_RTSP_PASSWORD=change-me
FRIGATE_CAMERA_FRONT_HOST=192.168.1.20

# --- Zigbee2MQTT frontend (loopback only) -----------------------------------
Z2M_FRONTEND_TOKEN=change-me
